{
  "name": "reelfetch",
  "version": "1.5.0",
  "private": true,
  "description": "ReelFetch - detect and download video/audio streams (HLS, DASH, direct media, MSE capture) from web pages.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "e2e:update": "node scripts/e2e-update.mjs",
    "icons": "node scripts/make-icons.mjs",
    "live:detect": "node scripts/live-detect.mjs",
    "live:youtube": "node scripts/live-check.mjs",
    "release": "node scripts/release.mjs",
    "release:deploy": "node scripts/release.mjs --deploy"
  },
  "reelfetch": {
    "updateUrl": "https://reelfetch-updates.thomas-schend.workers.dev",
    "cloudflareWorker": "reelfetch-updates"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "^1.65.0",
    "mediabunny": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
